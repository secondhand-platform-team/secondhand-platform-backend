# Copy to .env.prod and fill real production values before deploying.

POSTGRES_USER=secondhand
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=secondhand_auth_db
SPRING_DATASOURCE_USERNAME=secondhand
SPRING_DATASOURCE_PASSWORD=change-me-long-random

RABBITMQ_DEFAULT_USER=secondhand
RABBITMQ_DEFAULT_PASS=change-me-long-random
SPRING_RABBITMQ_USERNAME=secondhand
SPRING_RABBITMQ_PASSWORD=change-me-long-random

JWT_SECRET=change-me-at-least-64-random-chars
APP_SECURITY_COOKIE_SECURE=true
SECURITY_LOG_LEVEL=INFO
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_DEVTOOLS_RESTART_ENABLED=false

FRONTEND_BASE_URL=https://san-docu-relife.vercel.app
