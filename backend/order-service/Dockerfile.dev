FROM maven:3.9-eclipse-temurin-21

WORKDIR /app

# Pre-cache dependencies vào image layer (tăng tốc rebuild khi pom.xml không đổi)
COPY pom.xml .
RUN mvn -B -q -DskipTests dependency:go-offline

EXPOSE 8083

# Compile proto files trước, sau đó chạy spring-boot:run
# Cmd chạy compile (để generate proto files) rồi spring-boot:run
CMD ["sh", "-c", "mvn clean compile -q -B && mvn spring-boot:run"]
